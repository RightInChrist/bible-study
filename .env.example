# Copy to .env. Real values never committed.

# Environment: must be 'development' for the test-only admin hooks to mount.
ENV=development

# Bind host MUST be 127.0.0.1 or localhost for the launcher to start.
# (Security §Build-time guards: refuse to start otherwise.)
BIND_HOST=127.0.0.1
BIND_PORT=8000

# Extra hostnames added to the Host-header allowlist (comma-separated).
# DEV-ONLY: ignored when ENV != 'development' so a publicly-reachable
# staging/production process cannot have its DNS-rebinding defence widened
# by an env-var leak. Lets the local eval harness reach the API via
# host.docker.internal etc.
EXTRA_ALLOWED_HOSTS=

# Extra Origin values added to the CSRF allow-list (comma-separated).
# DEV-ONLY (matches EXTRA_ALLOWED_HOSTS). Eval harness in Docker uses
# this to send Origin: http://host.docker.internal:8000 from its container.
EXTRA_ALLOWED_ORIGINS=

# SQLite path — relative paths are resolved against the project root.
DATABASE_PATH=data/bible_study.db

# ---- Generation: Claude Code worktree subagents
# CLAUDE.md §Generation mechanism — translation candidates are produced
# by spawning the `claude` CLI inside a fresh git worktree per generation.
# Authentication uses whatever Claude Code is already logged in with on
# this machine; there is no API key plumbed through this app.

# Path to the `claude` executable. Override only if it doesn't resolve
# from PATH (rare).
CLAUDE_CLI_PATH=claude

# Default Claude model id passed via `claude -p --model <id>`. The CLI
# accepts an alias (e.g. `opus`) or a full name (e.g. `claude-opus-4-7`).
# This is what the runner pins per spawn so model identity is deterministic
# rather than inheriting whatever the user's interactive session selected.
CLAUDE_MODEL=claude-opus-4-7

# Default effort level passed via `claude -p --effort <level>`. The CLI
# accepts: low, medium, high, xhigh, max. Higher effort = more reasoning
# tokens = slower + better-grounded output.
CLAUDE_EFFORT=xhigh

# Where worktrees are created (and swept on startup).
WORKTREE_BASE_DIR=data/worktrees

# Subscription-aware caps — usage is bounded by Claude Code rate limits,
# not a USD-per-token meter. These are sanity bounds on this machine.
MAX_WORKTREES_PER_RUN=200
MAX_RUNS_PER_DAY=100
MAX_WALL_CLOCK_SECONDS_PER_SENTENCE=300
MAX_CONCURRENT_WORKTREES=2

# Per-failure-error truncation cap.
MAX_ERROR_MESSAGE_BYTES=2048

# Slice 3c — adjacent-sentence context window.
# When the active prompt's front-matter sets `wants_context_window: true`
# (currently first-century-jewish-v1), the source bundle is augmented
# with N preceding + N following SBLGNT sentences so the agent can frame
# the focal sentence in its pericope. Window may span chapter boundaries
# (e.g. Matt 4 narrative → Matt 5 beatitudes). Prompts that don't opt in
# get the focal-only bundle they always got, hashes unchanged.
CONTEXT_WINDOW_BEFORE=3
CONTEXT_WINDOW_AFTER=3

# Backups (Reliability §Backups).
BACKUP_INTERVAL_SECONDS=3600
BACKUP_RETENTION_COUNT=24
BACKUP_HARD_CAP=32
