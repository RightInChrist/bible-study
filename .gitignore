# Build artifacts (Reliability §Static-site atomic swap creates dist.tmp/ and dist.bak/)
dist/
dist.tmp/
dist.bak/

# Runtime data (gitignored per Hard decision #7 — SQLite is rebuildable)
data/
*.db
*.db-wal
*.db-shm

# Upstream raw downloads (large; the manifest pins their SHA-256 so a
# fresh download is byte-verified before the normalizer runs).
fixtures/_upstream/

